{
  "purpose": "Readable index of the current 4B recipe; existing launchers remain the execution source.",
  "model": "Qwen3.5-4B",
  "environment": "ALFWorld text",
  "gpus": [
    0,
    1,
    2,
    3
  ],
  "train_task_groups": 16,
  "group_size": 8,
  "learning_rate": 1e-06,
  "gamma": 0.95,
  "ppo_mini_batch_size": 256,
  "ppo_micro_batch_size_per_gpu": 64,
  "ppo_max_token_len_per_gpu": 20480,
  "forward_max_token_len_per_gpu": 131072,
  "skill_sft_coef": 0.1,
  "kl_loss_type": "low_var_kl",
  "kl_loss_coef": 0.01,
  "use_kl_in_reward": false,
  "rewrite_quality_enabled": false,
  "total_training_steps": 180,
  "test_freq": 5,
  "save_freq": 50,
  "validation_episodes": 128,
  "validation_split": "valid_seen",
  "strict_eval": false,
  "max_env_steps": 30,
  "skill_max_new_tokens": 256,
  "rewrite_max_new_tokens": 384,
  "max_skill_chars": 1800,
  "gpu_memory_utilization": 0.71,
  "optimizer_offload": true,
  "free_cache_engine": true,
  "default_resume_mode": "disable"
}
